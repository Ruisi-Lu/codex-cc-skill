{
  "description": "Activate the Codex pre-commit gate in clones of a repository that ships it, offer to install it where it is missing, and block Claude's commits while a shipped gate is inactive",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/gate.sh\" guard",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/gate.sh\" hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
